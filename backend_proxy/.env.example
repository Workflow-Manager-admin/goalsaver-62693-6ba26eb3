# Amazon Product Advertising API credentials (required for /amazon-product)
AMAZON_ACCESS_KEY=your_amazon_paapi_access_key
AMAZON_SECRET_KEY=your_amazon_paapi_secret_key
AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag
# Optional: set region (default is 'us-east-1')
# AMAZON_REGION=us-east-1

# Flipkart Affiliate API credentials (required for /flipkart-product)
FLIPKART_AFF_ID=your_flipkart_affiliate_id
FLIPKART_AFF_TOKEN=your_flipkart_affiliate_token
# Optional: custom Flipkart API endpoint override (default set in server.js)
# FLIPKART_API=https://affiliate-api.flipkart.net/affiliate/search/json

# Backend server port (default: 5001)
# PORT=5001
