# Example .env file for live API integrations — copy to .env and fill values to use live services

# --- Amazon Product Advertising API ---
REACT_APP_AMAZON_ACCESS_KEY=your_amazon_access_key
REACT_APP_AMAZON_SECRET_KEY=your_amazon_secret_key
REACT_APP_AMAZON_ASSOCIATE_TAG=your_amazon_associate_tag

# --- Flipkart Affiliate API ---
REACT_APP_FLIPKART_AFF_ID=your_flipkart_affiliate_id
REACT_APP_FLIPKART_AFF_TOKEN=your_flipkart_affiliate_token

# --- Backend Proxy Service URL for Authenticated Requests (recommended for Amazon/Flipkart, e.g., https://your-proxy-domain) ---
REACT_APP_AZON_BACKEND_PROXY=https://your-server.com/api/proxy
