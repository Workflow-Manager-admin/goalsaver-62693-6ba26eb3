# --- AMAZON/FLIPKART PRODUCT API ---
REACT_APP_AMAZON_ACCESS_KEY=YOUR_AMZN_KEY
REACT_APP_AMAZON_SECRET_KEY=YOUR_AMZN_SECRET
REACT_APP_AMAZON_ASSOCIATE_TAG=YOUR_AMZN_TAG
REACT_APP_AZON_BACKEND_PROXY=https://your-proxy-url

REACT_APP_FLIPKART_AFF_ID=your_aff_id
REACT_APP_FLIPKART_AFF_TOKEN=your_aff_token

# --- COURSES (PROXY URLS and keys) ---
REACT_APP_COURSERA_API_KEY=your_coursera_key
REACT_APP_COURSERA_PROXY=https://your-proxy-url

REACT_APP_UDEMY_PROXY=https://your-proxy-url

REACT_APP_SKILLSHARE_PROXY=https://your-proxy-url

# --- PUSH NOTIFICATION SERVICES ---

# OneSignal (Web push, progressive web apps)
REACT_APP_ONESIGNAL_APP_ID=your-onesignal-app-id
# For backend push, never expose REST KEY in frontend!
# REACT_APP_ONESIGNAL_REST_KEY=your-onesignal-rest-key

# Firebase Cloud Messaging (Web push)
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-firebase-auth-domain
REACT_APP_FIREBASE_PROJECT_ID=your-firebase-project-id
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id
# Optional for FCM VAPID Key (public):
REACT_APP_FIREBASE_VAPID_KEY=your-vapid-key

# --- DEV ONLY ---
# Never commit this .env file!
