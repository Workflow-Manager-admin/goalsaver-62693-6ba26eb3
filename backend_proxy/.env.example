# Backend Node.js proxy: Environment variables for secret API credentials
# NEVER COMMIT real credentials! Copy to .env and edit.

# Amazon Product Advertising API configuration
AMAZON_ACCESS_KEY=YOUR_AMZ_ACCESS_KEY
AMAZON_SECRET_KEY=YOUR_AMZ_SECRET_KEY
AMAZON_ASSOCIATE_TAG=YOUR_AMZ_ASSOC_TAG
AMAZON_REGION=us-east-1

# Flipkart Affiliate API credentials
FLIPKART_AFF_ID=YOUR_FLIPKART_AFFILIATE_ID
FLIPKART_AFF_TOKEN=YOUR_FLIPKART_AFFILIATE_TOKEN
# Optionally override API endpoint if needed (default is public legacy endpoint)
# FLIPKART_API=https://affiliate-api.flipkart.net/affiliate/search/json

# Backend server
PORT=5001
